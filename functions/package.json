    "brace-expansion": "1.1.18",
    "braces": "3.0.3",
    "browserslist": "4.28.7",
    "decode-uri-component": "^0.5.0",
    "flatted": "3.4.2",
    "form-data": "3.0.5",
    "js-yaml": "^3.15.2",
    "json5": "2.2.2",
