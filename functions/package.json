{
  "name": "functions",
  "main": "src/index.ts",
  "scripts": {
    "lint": "eslint --ext .js,.ts .",
    "build": "tsc --noEmit",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "test": "npx jest",
    "test:watch": "npx jest --watch"
  },
  "jest": {
    "projects": [
      {
        "displayName": "functions",
        "preset": "ts-jest",
        "testEnvironment": "node",
        "resetMocks": true,
