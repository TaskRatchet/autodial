          "<rootDir>/lib/"
        ]
      }
    ]
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "dependencies": {
    "@sentry/cloudflare": "^10.73.0",
    "@testing-library/jest-dom": "^7.0.1",
